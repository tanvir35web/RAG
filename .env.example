# Google Gemini
GEMINI_API_KEY=AIza...

# Pinecone
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX=rag-documents

# Optional overrides
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
PINECONE_NAMESPACE=documents
PINECONE_TOP_K=5

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Upload limits
MAX_FILE_SIZE_MB=50

# App
APP_ENV=production
LOG_LEVEL=INFO
API_PREFIX=/api/v1
